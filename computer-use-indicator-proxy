#!/usr/bin/python3
"""MCP stdio proxy for computer-use-linux.

Usage: computer-use-indicator-proxy AGENT -- SERVER [ARGS...]

Bytes pass through unchanged in both directions; every desktop tool call is
mirrored to the computer-use-indicator overlay as one JSON datagram.
"""

import json
import os
import socket
import subprocess
import sys
import threading
import time

SOCK = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"),
    "computer-use-indicator.sock",
)
HIDE_TEXT = os.environ.get("COMPUTER_USE_INDICATOR_HIDE_TEXT") == "1"
RUSSIAN = next(
    (os.environ[v] for v in ("LC_ALL", "LC_MESSAGES", "LANG") if os.environ.get(v)), ""
).startswith("ru")
# Screen captures must not contain the overlay, so these hide it first and
# are announced only once the server has answered.
OBSERVE = {"screenshot", "get_app_state"}
ACT = {
    "click", "drag", "scroll", "type_text", "press_key", "set_value",
    "perform_action", "activate_window", "move_window", "resize_window",
}
LABELS = {
    "screenshot": ("looking at the screen", "смотрит экран"),
    "get_app_state": ("looking at the screen", "смотрит экран"),
    "click": ("click", "клик"),
    "drag": ("drag", "перетаскивание"),
    "scroll": ("scroll", "прокрутка"),
    "type_text": ("typing", "ввод текста"),
    "press_key": ("key press", "клавиша"),
    "set_value": ("entering a value", "ввод значения"),
    "perform_action": ("action", "действие"),
    "activate_window": ("switching window", "переключение окна"),
    "move_window": ("moving window", "перемещение окна"),
    "resize_window": ("resizing window", "размер окна"),
}
SHOWN_FOR = 9.0  # overlay IDLE_BEFORE_FADE plus its fade-out
GLIDE = 0.45  # overlay MAX_GLIDE plus a frame: the cursor lands before the click


def label(name):
    en, ru = LABELS.get(name, (name, name))
    return ru if RUSSIAN else en


class Indicator:
    def __init__(self, agent):
        self.agent = agent
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
        self.shown_at = 0.0

    def send(self, event):
        try:
            self.sock.sendto(json.dumps(event).encode(), SOCK)
            return True
        except OSError:
            return False  # overlay not running; the proxy must never break the session

    def show(self, name, args):
        event = {"agent": self.agent, "tool": name, "label": label(name)}
        x, y = args.get("x"), args.get("y")
        # Window-relative coordinates cannot be placed on the desktop.
        if not args.get("relative") and isinstance(x, (int, float)) and isinstance(y, (int, float)):
            event["x"], event["y"] = x, y
        if name == "press_key" and isinstance(args.get("key"), str):
            event["keys"] = [k for k in args["key"].split("+") if k]
        typed = args.get("text") if name == "type_text" else args.get("value") if name == "set_value" else None
        if isinstance(typed, str):
            typed = typed[-64:]  # a datagram, not a transcript
            event["text"] = "•" * len(typed) if HIDE_TEXT else typed
        if self.send(event):
            self.shown_at = time.monotonic()
            if "x" in event:
                time.sleep(GLIDE)

    def hide_before_capture(self):
        if time.monotonic() - self.shown_at < SHOWN_FOR:
            self.send({"hide": True})
            time.sleep(0.15)  # let the compositor drop the surfaces


def parse(line):
    try:
        msg = json.loads(line)
    except ValueError:
        return None
    return msg if isinstance(msg, dict) else None


def main():
    if len(sys.argv) < 4 or sys.argv[2] != "--":
        sys.exit(__doc__)
    indicator = Indicator(sys.argv[1])
    child = subprocess.Popen(sys.argv[3:], stdin=subprocess.PIPE, stdout=subprocess.PIPE)
    observing = {}  # request id -> tool name

    def client_to_server():
        for line in sys.stdin.buffer:
            msg = parse(line)
            if msg and msg.get("method") == "tools/call":
                params = msg.get("params") or {}
                name, args = params.get("name", ""), params.get("arguments") or {}
                if name in OBSERVE:
                    indicator.hide_before_capture()
                    observing[msg.get("id")] = name
                elif name in ACT:
                    indicator.show(name, args)
            child.stdin.write(line)
            child.stdin.flush()
        child.stdin.close()

    threading.Thread(target=client_to_server, daemon=True).start()
    for line in child.stdout:
        sys.stdout.buffer.write(line)
        sys.stdout.buffer.flush()
        if observing:
            msg = parse(line)
            if msg and msg.get("id") in observing:
                indicator.show(observing.pop(msg["id"]), {})
    sys.exit(child.wait())


if __name__ == "__main__":
    main()
